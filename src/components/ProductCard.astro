---
const { product: p } = Astro.props;
---
<li>
  <article class="pcard" data-id={p.id}>
    <div class="pcard__media">
      
      <button class="add" type="button" data-add={p.id} aria-label={`Agregar a la cotización: ${p.name}`} aria-pressed="false"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
      <img src={p.img} alt={p.name} class:list={{'is-cover':p.cover}} loading="lazy" />
    </div>
    <div class="pcard__body"><h3>{p.name}</h3><p>{p.short}</p><button class="view" type="button" data-view={p.id}>Ver detalle</button></div>
  </article>
</li>
