---
import Brand from "./Brand.astro";
---
  <header class="nav" id="nav">
    <a class="logo" href="#inicio" aria-label="KRONO Industrial, inicio"><Brand /></a>

    <form class="search" id="searchForm" role="search" autocomplete="off">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input id="searchInput" type="search" placeholder="Buscar un producto…" aria-label="Buscar productos" aria-controls="suggest" aria-expanded="false" role="combobox">
      <ul class="suggest" id="suggest" role="listbox" hidden></ul>
    </form>

    <nav class="nav__links" aria-label="Principal">
      <a href="#catalogo">Productos</a>
      <a href="#soluciones">Soluciones</a><a href="#crecimiento">Nosotros</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <details class="mobile-menu"><summary aria-label="Abrir menú de navegación">☰</summary><nav aria-label="Navegación móvil"><a href="#soluciones">Soluciones ↗</a><a href="#catalogo">Productos ↗</a><a href="#crecimiento">Nosotros ↗</a><a href="#industria">Industria ↗</a><a href="#contacto">Tu proyecto ↗</a></nav></details>
    <button class="btn btn--dark nav__quote" type="button" id="openQuote">
      <span>Cotizar</span><em class="count" id="quoteCount" aria-label="productos en tu cotización">0</em>
    </button>
  </header>
