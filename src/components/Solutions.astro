const solutions = [
 {n:'01',title:'Temperatura bajo control.',text:'Controladores y resistencias para mantener estable cada etapa de tu proceso.',img:'robotica.jpg',alt:'Celda industrial con brazos robóticos y controladores',cat:'resistencias'},
 {n:'02',title:'La precisión empieza aquí.',text:'Sensores y transductores para convertir las variables de tu operación en información.',img:'precision.jpg',alt:'Herramienta de mecanizado de precisión',cat:'sensores'},
