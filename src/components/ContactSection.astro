<!-- CONTACTO -->
    <section class="contact" id="contacto">
      <div class="wrap contact__grid">
        <div class="vis vis--contact" data-contact-vis>
          <div class="vis__main"><img src="/img/operario.jpg" alt="Operario usando el panel táctil de una máquina" width="1280" height="853" loading="lazy"></div>
          <div class="vis__circle"><img src="/img/euro-heaters-accesorios-0014.jpeg" alt="Controlador digital de temperatura" width="960" height="960" loading="lazy"></div>
          <p class="vis__note">Un lugar para <b>resolver tu proceso.</b></p>
        </div>

        <div class="contact__copy">
          <h2 data-split>Cuéntanos qué necesita tu molde</h2>
          <p data-reveal>Atención cercana y recomendaciones pensadas para tu proceso, desde la primera consulta hasta la entrega.</p>
          <ul class="checks" role="list" data-reveal>
            <li>Una evaluación para conocer tus necesidades</li>
            <li>Opciones explicadas con claridad</li>
            <li>Seguimiento hasta recibir tu pedido</li>
          </ul>
          <form class="cform" id="contactForm" data-reveal>
            <p class="full quote__note">Formulario de prueba. Los datos no se envían.</p>
            <label>Nombre<input name="nombre" required autocomplete="name"></label>
            <label>Correo<input name="correo" type="email" required autocomplete="email"></label>
            <label class="full">Producto de interés<select name="producto" id="contactProduct"></select></label>
            <label class="full">Mensaje<textarea name="mensaje" rows="3" placeholder="Zonas, voltaje, resina que procesas…"></textarea></label>
            <button class="btn btn--accent btn--lg" type="submit">Enviar consulta <span aria-hidden="true">→</span></button>
          </form>
          <ul class="reach" role="list">
            <li><span>Correo</span><a href="mailto:ventas@ejemplo.com">ventas@ejemplo.com</a></li>
            <li><span>Teléfono</span><a href="tel:+520000000000">+52 00 0000 0000</a></li>
            <li><span>Oficina</span>Ciudad de México</li>
          </ul>
        </div>
      </div>
    </section>
