<!-- CONTACTO -->
    <section class="contact" id="contacto">
      <div class="wrap contact__grid">
        <div class="contact-image photo-reveal"><img src="/img/operario.jpg" alt="Operario configurando una máquina industrial" width="1280" height="853" loading="lazy" /><span>EL SIGUIENTE PASO EMPIEZA CONTIGO.</span></div><div class="contact__copy"><p class="eyebrow">05 / TU PRÓXIMO PROYECTO</p>
          <h2 data-reveal>Hagamos que las piezas encajen.</h2>
          <p data-reveal>Describe tu aplicación y prepara un documento con los datos que necesitas compartir con un especialista.</p>
          
          <form class="cform" id="contactForm" data-reveal>
            <p class="full quote__note">Descarga tu consulta para compartirla. No se envía automáticamente.</p>
            <label>Nombre<input name="nombre" required autocomplete="name"></label>
            <label>Correo<input name="correo" type="email" required autocomplete="email"></label>
            <label class="full">Producto de interés<select name="producto" id="contactProduct"></select></label>
            <label class="full">Mensaje<textarea name="mensaje" rows="3" placeholder="Zonas, voltaje, resina que procesas…"></textarea></label>
            <button class="btn btn--accent btn--lg" type="submit">Descargar consulta <span aria-hidden="true">→</span></button>
          </form>
          
        </div>
      </div>
    </section>
