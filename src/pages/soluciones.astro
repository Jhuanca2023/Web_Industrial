---
import ControlExperience from '../components/ControlExperience.astro';
import TechnicalGuide from '../components/TechnicalGuide.astro';
import IndustryStories from '../components/IndustryStories.astro';
import ChapterLayout from '../layouts/ChapterLayout.astro';
const systems=[
 {name:'Control térmico',image:'metal.jpg',alt:'Maquinaria trabajando metal a alta temperatura',copy:'La temperatura es parte del resultado. Explora resistencias y controladores para aportar calor y mantener las condiciones de tu proceso.',items:['Resistencias tubulares, planas y de banda','Controladores de temperatura','Configuraciones para colada caliente'],category:'resistencias'},
 {name:'Medición y precisión',image:'precision.jpg',alt:'Herramienta de precisión en un proceso de mecanizado',copy:'Convierte las variables de planta en información útil. Elige el sensor según el rango de trabajo, el medio y la conexión que necesita tu equipo.',items:['Termopares y sensores RTD','Transductores de presión','Lectura y control del proceso'],category:'sensores'},
 {name:'Inyección y colada',image:'ensamble.jpg',alt:'Línea automatizada de producción industrial',copy:'Coordina el calor y los tiempos del ciclo. Encuentra componentes para sistemas de inyección y revisa los requisitos de cada configuración.',items:['Control de tiempo de inyección','Puntas para colada caliente','Controladores multizona'],category:'controladores'}
];
---
<ChapterLayout title="Soluciones · Krono" description="Explora soluciones de control térmico, medición e inyección. Encuentra los componentes adecuados para tu proceso.">
 <section class="chapter-hero solutions-hero"><div class="chapter-photo"><img src="/img/metal.jpg" alt="Máquina de corte industrial en plena operación" fetchpriority="high" width="1800" height="1200" /></div><div class="wrap chapter-hero-copy"><p class="eyebrow">SOLUCIONES / INGENIERÍA APLICADA</p><h1 data-chapter-title>Cada proceso.<br /><em>Una posibilidad.</em></h1><p>Entender lo que sucede en tu planta.<br />Elegir lo que la hace avanzar.</p><a href="#sistemas" class="btn btn--accent">Encuentra tu solución ↓</a></div><span class="chapter-outline" aria-hidden="true">SOLUCIONES</span></section>
 <section class="solution-selector wrap" id="sistemas"><div class="chapter-section-title"><p class="eyebrow">TRES FORMAS DE CONECTAR TU OPERACIÓN</p><h2 data-chapter-reveal>Elige el punto<br />de partida.</h2></div><div class="systems-layout"><div class="systems-photo">{systems.map((s,i)=><img src={'/img/'+s.image} alt={s.alt} width="1000" height="1100" loading="lazy" data-system-image={i} class:list={{'is-active':i===0}} />)}<span id="systemCaption">01 / CONTROL TÉRMICO</span></div><div class="systems-list">{systems.map((s,i)=><details class="system-item" name="systems" open={i===0} data-system={i}><summary><span>0{i+1}</span>{s.name}<b>↗</b></summary><div class="system-content"><p>{s.copy}</p><ul>{s.items.map(t=><li>{t}</li>)}</ul><a class="link" href={'/?categoria='+s.category+'#catalogo'}>Explorar componentes →</a></div></details>)}</div></div></section>
 <ControlExperience />
 <IndustryStories />
 <TechnicalGuide />
 <section class="application-band"><div class="wrap"><p class="eyebrow">LA APLICACIÓN DEFINE LA ELECCIÓN</p><h2 data-chapter-reveal>Del plástico<br />a la próxima idea.</h2><div class="application-grid"><article><span>01</span><h3>Inyección de plástico</h3><p>Temperatura, presión y tiempos que intervienen en cada ciclo de moldeo.</p></article><article><span>02</span><h3>Empaque</h3><p>Elementos térmicos y medición para procesos de sellado y transformación.</p></article><article><span>03</span><h3>Manufactura</h3><p>Componentes para integrar, mantener y comprender tu equipo industrial.</p></article></div></div></section>
 <section class="next-chapter wrap"><p>EL SIGUIENTE PASO</p><a href="/contacto/">Dale forma<br />a tu proyecto.<span>↗</span></a></section>
</ChapterLayout>
