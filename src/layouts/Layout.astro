---
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '../styles/global.css';
import '../styles/krono.css';
import '../styles/motion.css';
import '../styles/chapters.css';
import '../styles/renewal.css';
const { title = 'Krono · Ingeniería en movimiento', description = 'Control térmico, sensores y componentes industriales. Explora soluciones, consulta fichas técnicas y prepara tu selección de productos.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101317" />
    <link rel="icon" type="image/png" href="/img/logo-krono.png" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href={Astro.url.pathname === "/" ? "#catalogo" : "#contenido"}>Saltar al contenido</a>
    <slot />
  </body>
</html>
